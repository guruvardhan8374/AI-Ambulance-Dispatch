# ==============================================================================
# RESPONSAI AI Ambulance Dispatch - Production Environment Variables
# Copy this file to .env and configure secrets before deploying to AWS EC2
# ==============================================================================

# Application Security
# Set a unique cryptographically secure string (e.g. generate via: openssl rand -hex 32)
SECRET_KEY=generate_and_insert_secure_random_key_here

# Persistent SQLite database location in container
DATABASE_URL=sqlite:////app/data/sql_app.db

# JWT Access Token Expiry in Minutes (10080 = 7 days)
TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
# When accessed through Nginx reverse proxy, API requests are same-origin.
# Add your custom domain or EC2 public IP if direct cross-origin access is required.
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
